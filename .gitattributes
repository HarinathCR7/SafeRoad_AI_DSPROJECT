# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files that must have LF line endings
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows command batch files must have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (do not convert line endings)
*.docx binary
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.db binary
*.sqlite3 binary
