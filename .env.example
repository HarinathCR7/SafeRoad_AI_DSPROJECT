# ==========================================
# SafeRoad AI - Global Environment Configuration
# ==========================================

# ------------------------------------------
# Backend Settings
# ------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
RELOAD=true

# Database Connection (Default: SQLite for local execution)
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/saferoad_ai
DATABASE_URL=sqlite:///./saferoad.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------
# Frontend Settings
# ------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8001
