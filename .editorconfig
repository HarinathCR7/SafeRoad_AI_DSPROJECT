# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Python files use 4-space indentation (PEP 8)
[*.py]
indent_size = 4

# Batch files use CRLF
[*.{bat,cmd}]
end_of_line = crlf

# Markdown files may have intentional trailing spaces for line breaks
[*.md]
trim_trailing_whitespace = false
